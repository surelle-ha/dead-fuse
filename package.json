{
  "name": "dead-fuse-monorepo",
  "private": true,
  "scripts": {
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm --filter @surelle-ha/dead-fuse build && pnpm --filter dashboard build",
    "build:client": "pnpm --filter @surelle-ha/dead-fuse build",
    "build:dashboard": "pnpm --filter dashboard build",
    "migrate": "pnpm --filter dashboard migrate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
